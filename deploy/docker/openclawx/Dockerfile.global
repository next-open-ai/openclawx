# OpenClawX full runtime image (global / VPN — default PyPI).
# Multi-stage: bake Node deps + AgentScope venv, then copy a cleaned tree.
# Keeps @lancedb/lancedb and apache-arrow. Image stays offline-capable.

FROM node:22-bookworm-slim AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/openclawx

COPY package.docker.json ./package.json
COPY README.md README-EN.md ./
COPY bin ./bin
COPY scripts/lib ./scripts/lib
COPY apps/api/dist ./apps/api/dist
COPY apps/renderer/dist ./apps/renderer/dist
COPY apps/gateway/package.json ./apps/gateway/package.json
COPY apps/gateway/dist ./apps/gateway/dist
COPY packages/channel/package.json ./packages/channel/package.json
COPY packages/channel/dist ./packages/channel/dist
COPY runtimes/agentscope-runtime ./runtimes/agentscope-runtime
COPY deploy/docker/openclawx/slim-runtime.sh ./deploy/docker/openclawx/slim-runtime.sh

RUN npm install --omit=dev --no-audit --no-fund \
  && chmod +x bin/openclawx.mjs deploy/docker/openclawx/slim-runtime.sh \
  && python3 -m venv --copies runtimes/agentscope-runtime/.venv \
  && runtimes/agentscope-runtime/.venv/bin/python3 -m pip install --upgrade pip \
  && runtimes/agentscope-runtime/.venv/bin/python3 -m pip install -r runtimes/agentscope-runtime/requirements.txt \
  && bash deploy/docker/openclawx/slim-runtime.sh /opt/openclawx \
  && npm cache clean --force \
  && rm -rf /root/.npm /root/.cache /tmp/*

FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    OPENCLAWX_DATA_DIR=/opt/openclawx-data \
    OPENCLAWX_API_HOST=0.0.0.0 \
    OPENCLAWX_API_PORT=47832 \
    OPENCLAWX_AGENT_ENGINE=agentscope

WORKDIR /opt/openclawx

COPY --from=builder /opt/openclawx /opt/openclawx

RUN mkdir -p /opt/openclawx-data \
  && chmod +x bin/openclawx.mjs

EXPOSE 47832
VOLUME ["/opt/openclawx-data"]

CMD ["node", "bin/openclawx.mjs", "start"]
