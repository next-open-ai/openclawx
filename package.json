{
  "name": "@next-open-ai/openclawx",
  "version": "0.5.5",
  "private": false,
  "description": "Cross-platform local AI workspace.",
  "packageManager": "pnpm@10.20.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "openclawx": "./bin/openclawx.mjs"
  },
  "files": [
    "bin",
    "apps/api/dist",
    "apps/renderer/dist",
    "scripts/start-web.mjs",
    "scripts/lib",
    "runtimes/agentscope-runtime/src",
    "runtimes/agentscope-runtime/requirements.txt",
    "runtimes/agentscope-runtime/pyproject.toml",
    "README.md",
    "README-EN.md",
    "docs",
    "apps/gateway/package.json",
    "apps/gateway/dist",
    "packages/channel/package.json",
    "packages/channel/dist"
  ],
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.1",
    "@lancedb/lancedb": "0.22.3",
    "@larksuiteoapi/node-sdk": "^1.11.1",
    "@openclawx/channel": "file:./packages/channel",
    "apache-arrow": "18.1.0",
    "fastify": "^5.3.0",
    "fflate": "^0.8.3",
    "sql.js": "^1.14.2",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "pnpm --filter @openclawx/desktop dev",
    "web:build": "pnpm build",
    "web:start": "node scripts/start-web.mjs",
    "openclawx:start": "node bin/openclawx.mjs start",
    "openclawx:init": "node bin/openclawx.mjs init",
    "openclawx:doctor": "node bin/openclawx.mjs doctor",
    "build": "pnpm --filter @openclawx/contracts build && pnpm --filter @openclawx/tools build && pnpm --filter @openclawx/storage build && pnpm --filter @openclawx/channel build && pnpm --filter @openclawx/gateway build && pnpm --filter @openclawx/agent-core build && pnpm --filter @openclawx/orchestrator build && pnpm --filter @openclawx/api build && pnpm --filter @openclawx/renderer build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "tasks:smoke": "pnpm --filter @openclawx/api test && pnpm task-applications:regression",
    "task-template:regression": "node scripts/task-management-regression.mjs && node scripts/workflow-chat-return-regression.mjs && node scripts/task-parameter-bridge.test.mjs",
    "task-applications:regression": "node scripts/task-monitor-regression.mjs && node scripts/task-applications-ui-regression.mjs && pnpm task-template:regression",
    "lint": "pnpm -r --if-present lint",
    "package": "pnpm --filter @openclawx/desktop package",
    "size:check": "node scripts/check-size.mjs",
    "orch:smoke": "node scripts/headless-gateway-smoke.mjs",
    "project:regression": "pnpm --filter @openclawx/orchestrator test && pnpm --filter @openclawx/api test && pnpm --filter @openclawx/renderer build && node scripts/lightweight-project-regression.mjs && node scripts/project-composer-regression.mjs && node scripts/project-conversation-presentation-regression.mjs && node scripts/project-application-regression.mjs",
    "orch:remote-confirm": "node scripts/remote-project-confirm.mjs",
    "orch:remote-chat": "node scripts/remote-chat.mjs",
    "chat-attachments:regression": "pnpm --filter @openclawx/agent-core build && pnpm --filter @openclawx/orchestrator build && pnpm --filter @openclawx/api build && node scripts/chat-attachments-regression.mjs",
    "voice:ui:regression": "node scripts/voice-composer-regression.mjs",
    "voice:command:regression": "node scripts/voice-command-regression.mjs",
    "voice:ui:preview": "node scripts/voice-composer-preview.mjs",
    "quality:console": "./tests/test-console open",
    "quality:console:stop": "./tests/test-console stop",
    "quality:console:test": "python3 -m unittest discover -s tests/console -p 'test_*.py' -v && node --check tests/console/static/app.js",
    "durable-task:regression": "node scripts/durable-task-regression.mjs",
    "gateway:stub": "node scripts/gateway-stub-smoke.mjs",
    "gateway:config": "node scripts/gateway-config.mjs",
    "gateway:feishu": "node scripts/gateway-feishu-smoke.mjs",
    "gateway:relay": "node scripts/relay-smoke.mjs",
    "agentscope:smoke": "node scripts/agentscope-smoke.mjs",
    "dsh:regression": "node scripts/dsh-mcp-skills-regression.mjs",
    "esight:contracts:regression": "pnpm --filter @openclawx/contracts build && node scripts/esight-contracts-regression.mjs",
    "mcp:user-scope:regression": "node scripts/mcp-user-scope-regression.mjs",
    "manual:generate": "node scripts/generate-user-manual.mjs",
    "manual:images": "node scripts/optimize-user-manual-images.mjs",
    "manual:regression": "pnpm --filter @openclawx/renderer build && node scripts/user-manual-regression.mjs",
    "concurrency:loadtest": "node scripts/concurrency-loadtest.mjs",
    "concurrency:regression": "node scripts/concurrency-regression.mjs",
    "routes:demo": "pnpm --filter @openclawx/contracts build && pnpm --filter @openclawx/agent-core build && pnpm --filter @openclawx/orchestrator build && node --test packages/orchestrator/dist/test/run-diagnostics.test.js && node scripts/run-diagnostics-regression.mjs",
    "owner:migrate:check": "node scripts/migrate-owner-fields.mjs",
    "owner:migrate": "node scripts/migrate-owner-fields.mjs --write"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitepress": "2.0.0-alpha.20",
    "ws": "^8.18.0"
  }
}
