{
  "name": "@workmate/desktop",
  "version": "0.2.16",
  "private": true,
  "description": "Workmate cross-platform local AI workspace.",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @workmate/contracts build && pnpm --filter @workmate/tools build && pnpm --filter @workmate/storage build && pnpm --filter @workmate/channel build && pnpm --filter @workmate/gateway build && pnpm --filter @workmate/agent-core build && pnpm --filter @workmate/orchestrator build && pnpm --filter @workmate/api build && pnpm --filter @workmate/renderer build",
    "stage": "node scripts/stage.mjs",
    "package": "node ../../scripts/prepare-agentscope-runtime.mjs && pnpm build && pnpm stage && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^24.13.3",
    "electron-builder-squirrel-windows": "^24.13.3",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.openclawx.desktop",
    "productName": "OpenClawX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "src/main/**",
      "src/preload/**",
      "stage/renderer/**",
      "stage/sqljs/**"
    ],
    "extraResources": [
      {
        "from": "stage/api",
        "to": "api"
      },
      {
        "from": "stage/agentscope-runtime",
        "to": "agentscope-runtime"
      }
    ],
    "asar": true,
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  }
}
